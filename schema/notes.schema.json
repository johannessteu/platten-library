{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platten.steu.de/schema/notes.schema.json",
  "title": "Plattennotizen",
  "description": "Liner notes for one record, written in German by the liner-notes skill. One file per Discogs release id: data/notes/<id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kicker", "tag", "record", "facts", "start", "band", "trivia", "similar", "sources"],
  "properties": {
    "kicker": {
      "description": "<Herkunft> · aktiv seit <Jahr> · <Kern-Genre in 2–4 Worten>",
      "type": "string",
      "minLength": 10,
      "maxLength": 90
    },
    "tag": {
      "description": "Griffiges Playlist-Schlagwort, 2–4 Wörter.",
      "type": "string",
      "minLength": 3,
      "maxLength": 40
    },
    "record": {
      "description": "2–3 Sätze: Was ist das für ein Album, warum ist es interessant?",
      "type": "string",
      "minLength": 80,
      "maxLength": 480
    },
    "facts": {
      "description": "Belegte Eckdaten des Originalalbums, z. B. Erschienen, Label, Produktion, Aufgenommen.",
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["k", "v"],
        "properties": {
          "k": { "type": "string", "minLength": 2, "maxLength": 24 },
          "v": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "start": {
      "description": "2–3 Songs dieser Platte zum Einstieg, Titel exakt wie in der Titelliste.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "why"],
        "properties": {
          "t": { "type": "string", "minLength": 1, "maxLength": 90 },
          "why": { "type": "string", "minLength": 10, "maxLength": 140 }
        }
      }
    },
    "band": {
      "description": "3–4 Sätze über Künstler oder Band.",
      "type": "string",
      "minLength": 80,
      "maxLength": 620
    },
    "trivia": {
      "description": "2–3 belegte Fakten, je ein Satz.",
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 10, "maxLength": 220 }
    },
    "similar": {
      "description": "3–4 ähnliche Künstler. Steht einer davon im Regal, exakt so schreiben wie in data/records.",
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["a", "why"],
        "properties": {
          "a": { "type": "string", "minLength": 1, "maxLength": 80 },
          "why": { "type": "string", "minLength": 10, "maxLength": 140 }
        }
      }
    },
    "sources": {
      "description": "Tatsächlich genutzte Quellen.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 2, "maxLength": 60 },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "writtenAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
