{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platten.johannessteu.de/schema/artist.schema.json",
  "title": "Künstlerprofil",
  "description": "The longer artist profile behind „Mehr über …“ in the detail view, written in German by the liner-notes skill. One file per artist: data/artists/<slug>.json (slug from src/lib/artists.ts).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "summary", "career", "sound", "highlights", "discography", "sources"],
  "properties": {
    "name": {
      "description": "Exactly as the artist field in data/records.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "description": "3–5 Sätze: Wer ist das, wofür steht der Act, warum ist er relevant?",
      "type": "string",
      "minLength": 150,
      "maxLength": 750
    },
    "career": {
      "description": "Werdegang & Background: 2–4 Absätze, chronologisch, immer mit dem Warum.",
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 120, "maxLength": 950 }
    },
    "sound": {
      "description": "Genre-Einordnung: Grundgenre, Einflüsse, Szene, Besonderheiten im Sound.",
      "type": "string",
      "minLength": 120,
      "maxLength": 750
    },
    "highlights": {
      "description": "Interessantes: 3–6 belegte Fakten, je ein bis zwei Sätze.",
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 20, "maxLength": 260 }
    },
    "discography": {
      "description": "Studioalben vollständig, chronologisch; Live, EP, Compilation nur wenn wichtig oder im Regal.",
      "type": "array",
      "minItems": 1,
      "maxItems": 45,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "year", "type"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "year": { "type": "integer" },
          "type": { "type": "string", "enum": ["Studioalbum", "Livealbum", "EP", "Compilation", "Soundtrack"] },
          "note": { "type": "string", "minLength": 10, "maxLength": 220 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 2, "maxLength": 60 },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "writtenAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
